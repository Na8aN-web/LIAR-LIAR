{
  "name": "wanted-true-colors",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm --parallel --filter @wtc/server --filter @wtc/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke": "pnpm --filter @wtc/server smoke",
