{
  "name": "wanted-true-colors",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm --parallel --filter @wtc/server --filter @wtc/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke": "pnpm --filter @wtc/server smoke",
    "sim": "pnpm --filter @wtc/server sim",
    "sweep": "pnpm --filter @wtc/server sweep",
    "stats": "pnpm --filter @wtc/server stats",
    "playtest": "node tools/playtest.mjs",
    "proxy": "node tools/proxy.mjs",
    "model": "node tools/build-character.mjs",
    "scenery": "node tools/build-scenery.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "fbx2gltf": "0.9.7-p1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
