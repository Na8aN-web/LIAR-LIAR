    "sweep": "pnpm --filter @wtc/server sweep",
    "stats": "pnpm --filter @wtc/server stats",
    "playtest": "node tools/playtest.mjs",
    "proxy": "node tools/proxy.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
